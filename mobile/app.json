{
  "expo": {
    "name": "School17",
    "slug": "school17",
    "scheme": "school17",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": { "image": "./assets/logo.png", "resizeMode": "contain", "backgroundColor": "#0B4F6C" },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.school17.app",
      "infoPlist": { "UIBackgroundModes": ["audio"] }
    },
    "android": {
      "package": "uz.school17.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B4F6C"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      "expo-web-browser",
      [
        "expo-contacts",
        {
          "contactsPermission": "School17 compares the phone numbers of your contacts (scrambled on your phone, never stored) to show which friends already use the app. You can turn this off at any time."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "School17 needs access to your photos to attach a payment receipt or homework image."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "65e80335-adf1-4713-a7df-a6adfa7a643e"
      }
    }
  }
}