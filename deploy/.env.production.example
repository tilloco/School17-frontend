# Copy to ../.env on the server and fill in every value. Never commit the filled-in file.
# Make each secret a long random string, for example:  openssl rand -base64 48

DOMAIN=api.mamunapp.xyz
POSTGRES_PASSWORD=
JWT_SECRET=
ADMIN_JWT_SECRET=
OTP_PEPPER=
# The app and admin site origins that may call the API (comma separated, https only)
ALLOWED_ORIGINS=https://api.mamunapp.xyz

# Video server key pair (choose any key name and a long secret)
LIVEKIT_API_KEY=school17
LIVEKIT_API_SECRET=

# Sign-in with Google (the Web client id from Google Cloud) and phone codes through Telegram (optional)
GOOGLE_CLIENT_ID=
TELEGRAM_GATEWAY_TOKEN=

# Push notifications through Expo (set to 1 and give the token to turn on)
EXPO_PUSH_ENABLED=0
EXPO_ACCESS_TOKEN=

# Shown on the public privacy and account-deletion pages. Use an address you read.
SUPPORT_EMAIL=
# Set to 1 only after a lawyer has reviewed the privacy policy and terms; until then the pages carry a "draft" banner
LEGAL_REVIEWED=0
# Text that fills the gaps the draft policy leaves open (ask your lawyer for the exact wording)
LEGAL_OPERATOR=
LEGAL_RETENTION=
